# MARS Environment Variables

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://mars_user:mars_password@localhost:5432/mars_db?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-long"

# Music Providers APIs
# Jamendo (Developer Client ID from https://developer.jamendo.com)
JAMENDO_CLIENT_ID=""

# SoundCloud (Client ID from SoundCloud Developer / App)
SOUNDCLOUD_CLIENT_ID=""

# Apple Music (MusicKit Developer Token & Private Key - Stage 3+)
APPLE_MUSIC_DEVELOPER_TOKEN=""
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_KEY_ID=""

# YouTube Data API v3 (Google Cloud Console - Stage 3+)
YOUTUBE_API_KEY=""
